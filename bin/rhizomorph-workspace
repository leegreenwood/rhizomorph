#!/bin/zsh
# Ensure the "Rhizomorph" Herdr workspace exists and its panes are running:
#   left = live status board (bin/rhizomorph-status), top right = merged log tail,
#   bottom right = the Spores worker, started on demand by checks/spores/tick.js and otherwise a bare shell.
# Idempotent. Herdr restores a workspace's panes after a restart but not the commands inside them, so
# an existing workspace is repaired: any pane that is back at a bare shell gets its command restarted.
# Waits for the Herdr server, so it can run at login (com.rhizomorph.workspace) before the server is up.
# With --spores-pane, stdout is only the Spores pane's id, for tick.js to read.
SPORES_PANE_MODE=
if [[ $1 == --spores-pane ]]; then
  SPORES_PANE_MODE=1
  exec 3>&1 1>&2
fi
ROOT="${0:A:h:h}"
LABEL=Rhizomorph
STATUS_CMD="$ROOT/bin/rhizomorph-status"
LOGS_CMD="tail -n 20 -F $ROOT/receivers/netlify/logs/out.log $ROOT/receivers/github/logs/out.log $ROOT/checks/repeat-after-completion/logs/repeat-after-completion.log $ROOT/checks/board-labels/logs/board-labels.log"

json() { python3 -c "import sys,json; d=json.load(sys.stdin); $1"; }

WAITED=0
until herdr workspace list 2>/dev/null | json "d['result']['workspaces']" 2>/dev/null; do
  if (( WAITED >= 120 )); then
    echo "Herdr server not reachable after ${WAITED}s." >&2
    exit 1
  fi
  sleep 2
  (( WAITED += 2 ))
done

# Match the label case-insensitively: a workspace renamed "rhizomorph" in Herdr is still this one.
WS=$(herdr workspace list | json "print(next((w['workspace_id'] for w in d['result']['workspaces'] if (w.get('label') or '').lower()=='$LABEL'.lower()), ''))")

if [[ -z "$WS" ]]; then
  CREATED=$(herdr workspace create --cwd "$ROOT" --label "$LABEL" --no-focus)
  WS=$(print -r -- "$CREATED" | json "print(d['result']['workspace']['workspace_id'])")
  ROOT_PANE=$(print -r -- "$CREATED" | json "print(d['result']['root_pane']['pane_id'])")
  herdr pane split "$ROOT_PANE" --direction right --cwd "$ROOT" --no-focus >/dev/null
  echo "Created workspace \"$LABEL\" ($WS)."
fi

# Panes in creation order: first = status board, second = logs, third = Spores worker.
list_panes() {
  PANES=(${(f)"$(herdr pane list | json "
ids=[p['pane_id'] for p in d['result']['panes'] if p.get('workspace_id')=='$WS']
print('\n'.join(sorted(ids, key=lambda s: [int(x) for x in __import__('re').findall(r'\d+', s)])))")"})
}
list_panes

if (( ${#PANES} < 2 )); then
  echo "Workspace \"$LABEL\" ($WS) has ${#PANES} pane(s), expected at least 2 — close it in Herdr and re-run." >&2
  exit 1
fi

if (( ${#PANES} < 3 )); then
  herdr pane split "${PANES[2]}" --direction down --cwd "$ROOT" --no-focus >/dev/null
  list_panes
  herdr pane rename "${PANES[3]}" Spores >/dev/null
  echo "  ${PANES[3]}: added for the Spores worker"
fi

ensure() { # pane, marker that identifies the running command, command to start
  local pane=$1 marker=$2 cmd=$3
  if herdr pane process-info --pane "$pane" | json "sys_exit = 0 if any('$marker' in p.get('cmdline','') for p in d['result']['process_info']['foreground_processes']) else 1; raise SystemExit(sys_exit)"; then
    echo "  $pane: already running"
  else
    herdr pane run "$pane" "$cmd" >/dev/null && echo "  $pane: started"
  fi
}

echo "Workspace \"$LABEL\" ($WS):"
ensure "${PANES[1]}" "rhizomorph-status" "$STATUS_CMD"
ensure "${PANES[2]}" "tail -n 20 -F" "$LOGS_CMD"

[[ -n $SPORES_PANE_MODE ]] && print -u3 -- "${PANES[3]}"
exit 0
