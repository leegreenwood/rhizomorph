# imap (default; Gmail app passwords, no Superhuman needed) or superhuman (the MCP route)
MAIL_BACKEND=imap
# Gmail accounts to check, comma-separated. Each needs `board_labels.py --imap-auth <email>` once.
GMAIL_ACCOUNTS=lee.greenwood@gmail.com
# Brother QL-810W on the LAN (port 9100). Leave unset to fall back to the USB-attached CUPS queue.
PRINTER_IP=
# CUPS queue name for the USB fallback (default Brother_QL_810W, see `lpstat -p`).
# PRINTER_CUPS_QUEUE=Brother_QL_810W
# Same Moshi webhook token the receivers use; print failures are pushed through it.
MOSHI_WEBHOOK_TOKEN=
