<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rhizomorph.receiver-netlify</string>
  <!-- Absolute server.js path keeps the pgrep -fl "receivers/netlify/server.js" pattern working. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@22/bin/node</string>
    <string>--env-file=/Users/leegreenwood/Code/rhizomorph/receivers/netlify/.env</string>
    <string>/Users/leegreenwood/Code/rhizomorph/receivers/netlify/server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/leegreenwood/Code/rhizomorph/receivers/netlify</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/leegreenwood</string>
    <key>PATH</key><string>/opt/homebrew/opt/node@22/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/leegreenwood/Code/rhizomorph/receivers/netlify/logs/out.log</string>
  <key>StandardErrorPath</key><string>/Users/leegreenwood/Code/rhizomorph/receivers/netlify/logs/out.log</string>
</dict>
</plist>
